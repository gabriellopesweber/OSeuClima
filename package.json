{
  "name": "oseuclima",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode development",
    "build-dev": "vite build --mode development",
    "build-prod": "vite build --mode production",
    "preview": "vite preview",
    "lint": "eslint \"./src/**/*.{js,vue}\"",
    "lint:fix": "eslint \"./src/**/*.{js,vue}\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "rules:sync": "npx -y github:gabriellopesweber/vue-claude-rules#v1.8.0 sync",
    "rules:check": "npx -y github:gabriellopesweber/vue-claude-rules#v1.8.0 sync --check"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@mdi/js": "^7.4.47",
    "three": "^0.185.1",
    "vue": "^3.5.30",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.0.3",
    "vuetify": "^4.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^9.39.4",
    "eslint-plugin-vue": "^10.8.0",
    "eslint-plugin-vuetify": "^2.7.0",
    "globals": "^16.5.0",
    "jsdom": "^30.0.0",
    "vite": "^6.4.1",
    "vite-plugin-checker": "^0.9.3",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.4.0"
  },
  "claudeRules": {
    "rules": [
      "vue",
      "dry",
      "vuetify",
      "feedback",
      "composables",
      "services",
      "repositories",
      "i18n",
      "tests"
    ]
  }
}
